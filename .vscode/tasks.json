      "type": "shell",
      "command": "STM32_Programmer_CLI",
      "args": ["-c", "port=SWD", "-w", "cpr-raster-board/build/cpr-raster-board.bin", "0x08000000", "-v", "-rst"],
      "problemMatcher": []
